<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CommitDock.ViewModels"
             xmlns:v="using:CommitDock.Views"
             xmlns:c="using:CommitDock.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CommitDock.Views.WorkingCopy"
             x:DataType="vm:WorkingCopy">
  <v:WorkingCopyLayout SizeChanged="OnMainLayoutSizeChanged" Background="{DynamicResource Brush.SubPanel}">
    <v:WorkingCopyLayout.ColumnDefinitions>
      <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkingCopyLeftWidth, Mode=TwoWay}" MinWidth="300"/>
      <ColumnDefinition Width="4"/>
      <ColumnDefinition Width="*" MinWidth="470"/>
    </v:WorkingCopyLayout.ColumnDefinitions>

    <!-- Left -->
    <Grid Grid.Column="0" Background="{DynamicResource Brush.Window}">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" MinHeight="40" MaxHeight="40"/>
        <RowDefinition Height="*" MinHeight="100"/>
        <RowDefinition Height="1"/>
        <RowDefinition Height="*" MinHeight="100"/>
      </Grid.RowDefinitions>

      <!-- Search Filter -->
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <ToggleButton Grid.Column="0"
                        Classes="sidebar_expander"
                        Width="32"
                        VerticalAlignment="Center"
                        IsChecked="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.IsSidebarCollapsedInLocalChanges, Mode=TwoWay}"/>
          
          <TextBox Grid.Column="1"
                   x:Name="LocalChangesSearchBox"
                   Height="28"
                   Margin="4,0"
                   BorderThickness="1"
                   CornerRadius="{DynamicResource Radius.Medium}"
                   Text="{Binding Filter, Mode=TwoWay}"
                   BorderBrush="{DynamicResource Brush.Border2}"
                   Watermark="{DynamicResource Text.WorkingCopy.FilterChanges}"
                   VerticalContentAlignment="Center">
            <TextBox.InnerLeftContent>
              <Path Width="14" Height="14"
                    Margin="6,0,0,0"
                    Fill="{DynamicResource Brush.FG2}"
                    Data="{StaticResource Icons.Search}"/>
            </TextBox.InnerLeftContent>

            <TextBox.InnerRightContent>
              <Button Classes="icon_button"
                      Width="16"
                      Margin="0,0,6,0"
                      Command="{Binding ClearFilter}"
                      IsVisible="{Binding Filter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      HorizontalAlignment="Right">
                <Path Width="14" Height="14"
                      Margin="0,1,0,0"
                      Fill="{DynamicResource Brush.FG1}"
                      Data="{StaticResource Icons.Clear}"/>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <Button Grid.Column="2"
                  Classes="icon_button discard_all"
                  Width="28" Height="28"
                  Margin="2,0,10,0"
                  VerticalAlignment="Center"
                  Command="{Binding DiscardAllChanges}"
                  ToolTip.Tip="{DynamicResource Text.WorkingCopy.DiscardAll}">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Undo}"/>
          </Button>
          
          <v:ChangeViewModeSwitcher Grid.Column="3"
                                    Width="26"
                                    VerticalAlignment="Center"
                                    ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <!-- Unstaged -->
      <Grid Grid.Row="1" RowDefinitions="38,*">
        <!-- Unstaged Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
            <Path Grid.Column="0" Margin="10,0,0,0" Width="14" Height="14" Fill="{DynamicResource Brush.Modified}" Data="{StaticResource Icons.Changes}"/>
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
              <Run Text="{DynamicResource Text.WorkingCopy.Unstaged}"/>
              <Run Text="{Binding UnstagedCountInfo, Mode=OneWay}"/>
            </TextBlock>
            <v:LoadingIcon Grid.Column="2" Width="14" Height="14" Margin="8,0,0,0" IsVisible="{Binding IsStaging}"/>

            <Button Grid.Column="4"
                    Classes="icon_button"
                    Width="26" Height="26"
                    Padding="0"
                    ToolTip.Tip="{DynamicResource Text.WorkingCopy.Unstaged.ViewAssumeUnchanged}"
                    Click="OnOpenAssumeUnchanged">
              <Path Width="14" Height="14" Data="{StaticResource Icons.File.Ignore}"/>
            </Button>
            <ToggleButton Grid.Column="5"
                          Classes="toggle_untracked"
                          Width="26" Height="26"
                          ToolTip.Tip="{DynamicResource Text.WorkingCopy.IncludeUntracked}"
                          IsChecked="{Binding IncludeUntracked, Mode=TwoWay}"/>
            <Button Grid.Column="6"
                    Classes="icon_button"
                    Width="26" Height="26"
                    Padding="0"
                    IsVisible="{Binding HasUnsolvedConflicts}"
                    ToolTip.Tip="{DynamicResource Text.WorkingCopy.Conflicts.OpenExternalMergeToolAllConflicts}"
                    Click="OnOpenExternalMergeToolAllConflicts">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Conflict}"/>
            </Button>
            <Button Grid.Column="7"
                    Classes="icon_button"
                    Width="26" Height="26"
                    Padding="0"
                    Click="OnStageSelectedButtonClicked">
              <ToolTip.Tip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.Stage}" VerticalAlignment="Center"/>
                  <TextBlock Margin="16,0,0,0"
                             Text="{OnPlatform Space/Enter, macOS=␣/Enter}"
                             Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"
                             FontSize="11"
                             VerticalAlignment="Center"/>
                </StackPanel>
              </ToolTip.Tip>
              <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"/>
            </Button>
            <Button Grid.Column="8"
                    Classes="flat success"
                    Height="26"
                    Padding="10,0"
                    Margin="6,0,8,0"
                    ToolTip.Tip="{DynamicResource Text.WorkingCopy.Unstaged.StageAll}"
                    Click="OnStageAllButtonClicked">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="11" Height="11" Data="{StaticResource Icons.DoubleDown}"/>
                <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.StageAll}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Unstaged Changes -->
        <Grid Grid.Row="1">
          <v:ChangeCollectionView x:Name="UnstagedChangesView"
                                  IsUnstagedChange="True"
                                  Background="{DynamicResource Brush.Contents}"
                                  ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding VisibleUnstaged}"
                                  Selection="{Binding SelectedUnstaged, Mode=TwoWay}"
                                  ContextRequested="OnUnstagedContextRequested"
                                  ChangeDoubleTapped="OnUnstagedChangeDoubleTapped"
                                  KeyDown="OnUnstagedKeyDown"/>

          <v:EmptyState Icon="{StaticResource Icons.Changes}"
                        Title="{DynamicResource Text.WorkingCopy.Unstaged.Empty.Title}"
                        Description="{DynamicResource Text.WorkingCopy.Unstaged.Empty.Desc}"
                        IsVisible="{Binding Unstaged, Converter={x:Static c:ListConverters.IsNullOrEmpty}}"/>

          <v:EmptyState Icon="{StaticResource Icons.Search}"
                        Title="{DynamicResource Text.WorkingCopy.Unstaged.NoMatch.Title}"
                        Description="{DynamicResource Text.WorkingCopy.Unstaged.NoMatch.Desc}">
            <v:EmptyState.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Unstaged" Converter="{x:Static c:ListConverters.IsNotNullOrEmpty}"/>
                <Binding Path="VisibleUnstaged" Converter="{x:Static c:ListConverters.IsNullOrEmpty}"/>
              </MultiBinding>
            </v:EmptyState.IsVisible>
          </v:EmptyState>
        </Grid>
      </Grid>

      <!-- Splitter -->
      <GridSplitter Grid.Row="2"
                    MinHeight="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.Border0}"
                    Focusable="False"/>

      <!-- Staged -->
      <Grid Grid.Row="3" RowDefinitions="38,*">
        <!-- Staged Toolbar -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <Path Grid.Column="0" Margin="10,0,0,0" Width="14" Height="14" Fill="{DynamicResource Brush.Added}" Data="{StaticResource Icons.Check}"/>
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center">
              <Run Text="{DynamicResource Text.WorkingCopy.Staged}"/>
              <Run Text="{Binding StagedCountInfo, Mode=OneWay}"/>
            </TextBlock>
            <v:LoadingIcon Grid.Column="2" Width="14" Height="14" Margin="8,0,0,0" IsVisible="{Binding IsUnstaging}"/>
            <Button Grid.Column="4" Classes="icon_button" Width="26" Height="26" Padding="0" Click="OnUnstageSelectedButtonClicked">
              <ToolTip.Tip>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.Unstage}" VerticalAlignment="Center"/>
                  <TextBlock Margin="16,0,0,0"
                             Text="{OnPlatform Space/Enter, macOS=␣/Enter}"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                </StackPanel>
              </ToolTip.Tip>
              <Path Width="12" Height="12" Data="{StaticResource Icons.Up}"/>
            </Button>
            <Button Grid.Column="5"
                    Classes="flat"
                    Height="26"
                    Padding="10,0"
                    Margin="6,0,8,0"
                    ToolTip.Tip="{DynamicResource Text.WorkingCopy.Staged.UnstageAll}"
                    Click="OnUnstageAllButtonClicked">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="11" Height="11" Data="{StaticResource Icons.DoubleUp}"/>
                <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.UnstageAll}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Staged Changes -->
        <Grid Grid.Row="1">
          <v:ChangeCollectionView x:Name="StagedChangesView"
                                  IsUnstagedChange="False"
                                  Background="{DynamicResource Brush.Contents}"
                                  ViewMode="{Binding Source={x:Static vm:Preferences.Instance}, Path=ChangeViewMode}"
                                  EnableCompactFolders="{Binding Source={x:Static vm:Preferences.Instance}, Path=EnableCompactFoldersInChangesTree}"
                                  Changes="{Binding VisibleStaged}"
                                  Selection="{Binding SelectedStaged, Mode=TwoWay}"
                                  ContextRequested="OnStagedContextRequested"
                                  ChangeDoubleTapped="OnStagedChangeDoubleTapped"
                                  KeyDown="OnStagedKeyDown"/>

          <v:EmptyState Icon="{StaticResource Icons.Changes}"
                        Title="{DynamicResource Text.WorkingCopy.Staged.Empty.Title}"
                        Description="{DynamicResource Text.WorkingCopy.Staged.Empty.Desc}"
                        IsVisible="{Binding Staged, Converter={x:Static c:ListConverters.IsNullOrEmpty}}"/>

          <v:EmptyState Icon="{StaticResource Icons.Search}"
                        Title="{DynamicResource Text.WorkingCopy.Staged.NoMatch.Title}"
                        Description="{DynamicResource Text.WorkingCopy.Staged.NoMatch.Desc}">
            <v:EmptyState.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Staged" Converter="{x:Static c:ListConverters.IsNotNullOrEmpty}"/>
                <Binding Path="VisibleStaged" Converter="{x:Static c:ListConverters.IsNullOrEmpty}"/>
              </MultiBinding>
            </v:EmptyState.IsVisible>
          </v:EmptyState>
        </Grid>
      </Grid>
    </Grid>

    <GridSplitter Grid.Column="1"
                  MinWidth="1"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="1,0,0,0"
                  BorderBrush="{DynamicResource Brush.Border0}"
                  Focusable="False"/>

    <!-- Right -->
    <Grid x:Name="RightPane" Grid.Column="2" Margin="4,4,6,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="100"/>
        <RowDefinition Height="4"/>
        <RowDefinition Height="128" MinHeight="100"/>
        <RowDefinition Height="34"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>

      <!-- Select Change Detail -->
      <Grid x:Name="DiffArea" Grid.Row="0">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="320">
          <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Brush.Hover}" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Path Width="24" Height="24" Data="{StaticResource Icons.Diff}" Fill="{DynamicResource Brush.Accent}"/>
          </Border>
          <TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{DynamicResource Text.DiffView.Select.Title}"/>
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.DiffView.Select.Desc}"/>
        </StackPanel>

        <ContentControl x:Name="DiffContent" Content="{Binding DetailContext}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Conflict">
              <v:Conflict/>
            </DataTemplate>

            <DataTemplate DataType="vm:DiffContext">
              <v:DiffView/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>

      <!-- Splitter -->
      <GridSplitter x:Name="DiffSplitter" Grid.Row="1" MinHeight="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    Focusable="False"/>

      <!-- Commit Message -->
      <v:CommitMessageToolBox Grid.Row="2"
                              ShowAdvancedOptions="True"
                              CommitMessage="{Binding CommitMessage, Mode=TwoWay}"/>

      <!-- Commit Options -->
      <Grid Grid.Row="3" VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
        <CheckBox Grid.Column="0"
                  Height="24"
                  Margin="1,0,0,0"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding EnableSignOff, Mode=TwoWay}"
                  Content="{DynamicResource Text.WorkingCopy.SignOff}"
                  ToolTip.Tip="--signoff"
                  ToolTip.Placement="Top"
                  ToolTip.VerticalOffset="0"/>

        <CheckBox Grid.Column="1"
                  Height="24"
                  Margin="12,0,0,0"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding NoVerifyOnCommit, Mode=TwoWay}"
                  Content="{DynamicResource Text.WorkingCopy.NoVerify}"
                  ToolTip.Tip="--no-verify"
                  ToolTip.Placement="Top"
                  ToolTip.VerticalOffset="0"/>

        <CheckBox Grid.Column="2"
                  Height="24"
                  Margin="12,0,0,0"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding UseAmend, Mode=TwoWay}"
                  Content="{DynamicResource Text.WorkingCopy.Amend}"
                  ToolTip.Tip="--amend"
                  ToolTip.Placement="Top"
                  ToolTip.VerticalOffset="0"/>

        <CheckBox Grid.Column="3"
                  Height="24"
                  Margin="12,0,0,0"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding ResetAuthor, Mode=TwoWay}"
                  IsVisible="{Binding UseAmend}"
                  Content="{DynamicResource Text.WorkingCopy.ResetAuthor}"
                  ToolTip.Tip="--reset-author"
                  ToolTip.Placement="Top"
                  ToolTip.VerticalOffset="0"/>

        <v:LoadingIcon Grid.Column="4"
                       Width="18" Height="18"
                       HorizontalAlignment="Right"
                       IsVisible="{Binding IsCommitting}"/>

      </Grid>

      <!-- Commit Buttons -->
      <Grid Grid.Row="4" VerticalAlignment="Center" ColumnDefinitions="*,Auto,Auto">
        <SplitButton Grid.Column="0"
                     Content="{DynamicResource Text.Repository.Continue}"
                     Height="34"
                     HorizontalAlignment="Stretch"
                     Padding="18,0"
                     Click="OnContinue"
                     IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <SplitButton.Styles>
            <Style Selector="SplitButton">
              <Setter Property="MinHeight" Value="24"/>
              <Setter Property="Template">
                <ControlTemplate>
                  <Grid ColumnDefinitions="*,1,Auto">
                    <Button x:Name="PART_PrimaryButton"
                            Grid.Column="0"
                            Classes="flat primary"
                            MinWidth="32"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Command="{TemplateBinding Command}"
                            CommandParameter="{TemplateBinding CommandParameter}"
                            CornerRadius="6,0,0,6"
                            Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            KeyboardNavigation.IsTabStop="False" />

                    <Button x:Name="PART_SecondaryButton"
                            Grid.Column="2"
                            Classes="flat primary"
                            Width="32"
                            CornerRadius="0,6,6,0"
                            Padding="0"
                            Focusable="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            KeyboardNavigation.IsTabStop="False">
                      <Path Height="10" Width="10"
                            Data="{DynamicResource Icons.Down}"/>
                    </Button>
                  </Grid>
                </ControlTemplate>
              </Setter>

              <Style Selector="^:disabled /template/ Button">
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
                <Setter Property="Background" Value="Transparent"/>
              </Style>

              <Style Selector="^:disabled AccessText">
                <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
              </Style>

              <Style Selector="^:disabled Path">
                <Setter Property="Fill" Value="{DynamicResource Brush.FG2}"/>
              </Style>
            </Style>
          </SplitButton.Styles>

          <SplitButton.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="HasUnsolvedConflicts" Converter="{x:Static BoolConverters.Not}"/>
            </MultiBinding>
          </SplitButton.IsEnabled>
          <SplitButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="{DynamicResource Text.WorkingCopy.CommitToEdit}"
                        Click="OnCommit"
                        IsEnabled="{Binding CommitMessage, Converter={x:Static c:StringConverters.IsNotNullOrWhitespace}}"/>
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>

        <Button Grid.Column="0"
                Classes="flat primary"
                Content="{DynamicResource Text.WorkingCopy.Commit}"
                Height="34"
                HorizontalAlignment="Stretch"
                Padding="20,0"
                Click="OnCommit"
                HotKey="{OnPlatform Ctrl+Enter, macOS=⌘+Enter}"
                IsVisible="{Binding InProgressContext, Converter={x:Static ObjectConverters.IsNull}}"
                ToolTip.Placement="Top"
                ToolTip.VerticalOffset="0">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock TextAlignment="Left" TextWrapping="Wrap">
                <Run Text="{OnPlatform Ctrl+Enter, macOS=⌘+Enter}"/>
                <Run Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.WorkingCopy.CommitTip}"/>
              </TextBlock>
              <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="{OnPlatform Ctrl+Shift+Enter, macOS=⌘+⇧+Enter}"/>
                <Run Foreground="{DynamicResource Brush.FG2}" Text="{DynamicResource Text.WorkingCopy.CommitWithAutoStage}"/>
              </TextBlock>
            </StackPanel>
          </ToolTip.Tip>

          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>
        </Button>

        <!-- Invisible button just to add another hotkey `Ctrl+Shift+Enter` to commit with auto-stage -->
        <Button Grid.Column="1"
                Width="0" Height="0"
                Background="Transparent"
                Click="OnCommitWithAutoStage"
                HotKey="{OnPlatform Ctrl+Shift+Enter, macOS=⌘+Shift+Enter}">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>
        </Button>

        <Button Grid.Column="2"
                Classes="flat"
                Content="{DynamicResource Text.WorkingCopy.CommitAndPush}"
                Height="34"
                Margin="8,0,0,0"
                Padding="14,0"
                Click="OnCommitWithPush"
                HotKey="{OnPlatform Ctrl+Alt+Enter, macOS=⌘+Alt+Enter}"
                ToolTip.Tip="{OnPlatform Ctrl+Alt+Enter, macOS=⌘+⌥+Enter}"
                ToolTip.Placement="Top"
                ToolTip.VerticalOffset="0">
          <Button.IsEnabled>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsCommitting" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="CommitMessage" Converter="{x:Static c:StringConverters.IsNotNullOrWhitespace}"/>
            </MultiBinding>
          </Button.IsEnabled>

          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasRemotes"/>
              <Binding Path="UseAmend" Converter="{x:Static BoolConverters.Not}"/>
              <Binding Path="InProgressContext" Converter="{x:Static ObjectConverters.IsNull}"/>
            </MultiBinding>
          </Button.IsVisible>
        </Button>
      </Grid>
    </Grid>
  </v:WorkingCopyLayout>
</UserControl>
