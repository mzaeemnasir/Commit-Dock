<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="200"
             x:Class="CommitDock.Views.EmptyState"
             x:Name="ThisControl"
             IsHitTestVisible="False">
  <StackPanel Orientation="Vertical"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Spacing="4"
              MaxWidth="260"
              Margin="16">
    <Border Width="48" Height="48"
            CornerRadius="24"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Background="{DynamicResource Brush.Hover}">
      <Path Width="20" Height="20"
            Data="{Binding #ThisControl.Icon}"
            Fill="{DynamicResource Brush.Accent}"/>
    </Border>

    <TextBlock HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               FontWeight="SemiBold"
               Text="{Binding #ThisControl.Title}"/>

    <TextBlock HorizontalAlignment="Center"
               TextAlignment="Center"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.FG2}"
               Text="{Binding #ThisControl.Description}"
               IsVisible="{Binding #ThisControl.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
  </StackPanel>
</UserControl>
