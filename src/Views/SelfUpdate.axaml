<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:CommitDock.ViewModels"
                    xmlns:v="using:CommitDock.Views"
                    xmlns:c="using:CommitDock.Converters"
                    mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="520"
                    x:Class="CommitDock.Views.SelfUpdate"
                    x:DataType="vm:SelfUpdate"
                    x:Name="ThisControl"
                    Title="{DynamicResource Text.SelfUpdate.Title}"
                    Icon="/App.ico"
                    SizeToContent="WidthAndHeight"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.SoftwareUpdate}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.SelfUpdate.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1" Width="560">
      <!-- Checking -->
      <StackPanel Margin="24,32" Spacing="12" IsVisible="{Binding IsChecking}">
        <Path Width="22" Height="22" Classes="rotating" Fill="{DynamicResource Brush.Accent}"/>
        <TextBlock Text="{DynamicResource Text.SelfUpdate.Checking}" HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Up to date -->
      <StackPanel Margin="24,24" Spacing="12" IsVisible="{Binding IsUpToDate}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.CheckCircled}" Fill="{DynamicResource Brush.Success}"/>
          <TextBlock Text="{DynamicResource Text.SelfUpdate.UpToDate}" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG2}">
          <Run Text="{DynamicResource Text.SelfUpdate.CurrentVersion}"/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
        </TextBlock>

        <Button Classes="flat primary"
                Height="30" MinWidth="100"
                Click="CloseWindow"
                Content="{DynamicResource Text.Close}"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/>
      </StackPanel>

      <!-- Check failed -->
      <StackPanel Margin="24,24" Spacing="12" IsVisible="{Binding IsCheckFailed}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Path Width="16" Height="16" Data="{StaticResource Icons.Error}" Fill="{DynamicResource Brush.Danger}"/>
          <TextBlock Text="{DynamicResource Text.SelfUpdate.Error}" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   MaxWidth="480"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Brush.FG2}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button Classes="flat"
                  Height="30"
                  Click="GotoDownload"
                  Content="{DynamicResource Text.SelfUpdate.OpenReleasePage}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>
          <Button Classes="flat primary"
                  Height="30" MinWidth="100"
                  Click="CloseWindow"
                  Content="{DynamicResource Text.Close}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>
        </StackPanel>
      </StackPanel>

      <!-- New version -->
      <StackPanel Margin="20,18,20,18" IsVisible="{Binding HasNewVersion}">
        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0"
                  Width="44" Height="44"
                  CornerRadius="22"
                  Background="{DynamicResource Brush.Accent}"
                  VerticalAlignment="Top">
            <Path Width="22" Height="22" Data="{StaticResource Icons.SoftwareUpdate}" Fill="{DynamicResource Brush.OnAccent}"/>
          </Border>

          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Text="{DynamicResource Text.SelfUpdate.Available}"/>
              <Border Height="20" CornerRadius="10" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center">
                <TextBlock Margin="8,0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                           Text="{Binding Version.TagName, Mode=OneWay}"
                           Foreground="{DynamicResource Brush.OnAccent}"/>
              </Border>
            </StackPanel>

            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.FG2}">
              <Run Text="{DynamicResource Text.SelfUpdate.CurrentVersion}"/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
              <Run Text="   ·   "/>
              <Run Text="{DynamicResource Text.SelfUpdate.ReleaseDate}"/><Run Text="{Binding Version.ReleaseDateStr, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </Grid>

        <!-- Release notes -->
        <Border Margin="0,14,0,0"
                Height="260"
                Background="{DynamicResource Brush.Contents}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border2}"
                CornerRadius="{DynamicResource Radius.Small}"
                ClipToBounds="True">
          <v:UpdateInfoView DataContext="{Binding Version}"/>
        </Border>

        <!-- Available: actions -->
        <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding IsAvailable}">
          <Button Grid.Column="0"
                  Classes="flat"
                  Height="30"
                  Click="IgnoreThisVersion"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.File.Ignore}"/>
              <TextBlock Text="{DynamicResource Text.SelfUpdate.IgnoreThisVersion}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="2"
                  Classes="flat"
                  Height="30"
                  Margin="0,0,8,0"
                  Click="CloseWindow"
                  Content="{DynamicResource Text.SelfUpdate.Later}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>

          <Button Grid.Column="3"
                  Classes="flat primary"
                  Height="30"
                  Click="StartUpdate"
                  IsVisible="{Binding IsAutoInstall}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.SoftwareUpdate}"/>
              <TextBlock Text="{DynamicResource Text.SelfUpdate.InstallNow}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="3"
                  Classes="flat primary"
                  Height="30"
                  Click="StartUpdate"
                  IsVisible="{Binding IsSystemInstall}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Pull}"/>
              <TextBlock Text="{DynamicResource Text.SelfUpdate.GotoDownload}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>

          <Button Grid.Column="3"
                  Classes="flat primary"
                  Height="30"
                  Click="GotoDownload"
                  IsVisible="{Binding IsManualDownload}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Pull}"/>
              <TextBlock Text="{DynamicResource Text.SelfUpdate.GotoDownload}" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Downloading -->
        <StackPanel Margin="0,14,0,0" Spacing="6" IsVisible="{Binding IsDownloading}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding PackageName, Converter={x:Static c:StringConverters.FormatByResourceKey}, ConverterParameter=SelfUpdate.Downloading}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontWeight="Bold" Text="{Binding ProgressPercent}"/>
          </Grid>

          <ProgressBar Height="8"
                       HorizontalAlignment="Stretch"
                       Minimum="0" Maximum="100"
                       Value="{Binding Progress, Mode=OneWay}"
                       IsIndeterminate="{Binding IsProgressUnknown}"
                       Background="{DynamicResource Brush.Border2}"
                       Foreground="{DynamicResource Brush.Accent}"/>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="{Binding ProgressText}"/>
            <Button Grid.Column="1"
                    Classes="flat"
                    Height="28"
                    Click="CancelUpdate"
                    Content="{DynamicResource Text.Cancel}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
          </Grid>
        </StackPanel>

        <!-- Installing -->
        <StackPanel Margin="0,18,0,4" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsInstalling}">
          <Path Width="16" Height="16" Classes="rotating" Fill="{DynamicResource Brush.Accent}"/>
          <TextBlock Text="{DynamicResource Text.SelfUpdate.Installing}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Failed -->
        <StackPanel Margin="0,14,0,0" Spacing="10" IsVisible="{Binding IsFailed}">
          <Border Background="{DynamicResource Brush.SubPanel}"
                  BorderBrush="{DynamicResource Brush.Border2}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Radius.Small}"
                  Padding="10,8">
            <Grid ColumnDefinitions="Auto,*">
              <Path Grid.Column="0" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top" Data="{StaticResource Icons.Error}" Fill="{DynamicResource Brush.Danger}"/>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="{DynamicResource Text.SelfUpdate.InstallFailed}" FontWeight="Bold"/>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.FG2}"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="flat"
                    Height="30"
                    Click="GotoDownload"
                    Content="{DynamicResource Text.SelfUpdate.OpenReleasePage}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button Classes="flat primary"
                    Height="30" MinWidth="100"
                    Click="StartUpdate"
                    Content="{DynamicResource Text.SelfUpdate.Retry}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <!-- Handed to the package installer of the system -->
        <StackPanel Margin="0,14,0,0" Spacing="10" IsVisible="{Binding IsHandedToSystem}">
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0" Width="14" Height="14" Margin="0,2,0,0" VerticalAlignment="Top" Data="{StaticResource Icons.CheckCircled}" Fill="{DynamicResource Brush.Success}"/>
            <TextBlock Grid.Column="1" Margin="8,0,0,0" TextWrapping="Wrap" Text="{DynamicResource Text.SelfUpdate.HandedToSystem}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="flat"
                    Height="30"
                    Click="RevealDownload"
                    Content="{DynamicResource Text.SelfUpdate.ShowInFolder}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button Classes="flat primary"
                    Height="30" MinWidth="100"
                    Click="CloseWindow"
                    Content="{DynamicResource Text.Close}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</v:ChromelessWindow>
