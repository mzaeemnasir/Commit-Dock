<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:CommitDock.Models"
             xmlns:v="using:CommitDock.Views"
             xmlns:vm="using:CommitDock.ViewModels"
             xmlns:c="using:CommitDock.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CommitDock.Views.ChangeCollectionView"
             x:Name="ThisControl">
  <UserControl.Styles>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <!-- Rows: a soft rounded highlight on hover and selection, like the sidebar lists. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Name="PART_Background"
                    Background="Transparent"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"/>

            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Stretch"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value=".16"/>
    </Style>
    <Style Selector="ListBox:focus-within ListBoxItem:selected /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value=".28"/>
    </Style>
    <Style Selector="ListBox:focus-within ListBoxItem:selected:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Opacity" Value=".34"/>
    </Style>

    <!-- Stage/Unstage button that appears at the end of a row while the pointer is over it. -->
    <Style Selector="Button.row_action">
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="8,0,6,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.row_action">
      <Setter Property="IsVisible" Value="True"/>
    </Style>

    <Style Selector="Button.row_action.stage">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
    </Style>
    <Style Selector="Button.row_action.stage TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
    </Style>
    <Style Selector="Button.row_action.stage:pointerover /template/ Border#PART_Border">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Success}" Opacity="0.16"/>
      </Setter>
    </Style>

    <Style Selector="Button.row_action.unstage">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border1}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.row_action.unstage TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.FG1}"/>
    </Style>
    <Style Selector="Button.row_action.unstage:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:ChangeCollectionAsTree">
      <v:ChangeCollectionContainer Focusable="True"
                                   ItemsSource="{Binding Rows}"
                                   SelectedItems="{Binding SelectedRows, Mode=TwoWay}"
                                   SelectionMode="Multiple"
                                   SelectionChanged="OnRowSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ChangeTreeNode">
            <Grid ColumnDefinitions="*,Auto"
                  Height="26"
                  Background="Transparent"
                  DoubleTapped="OnRowDoubleTapped"
                  DataContextChanged="OnRowDataContextChanged">
              <Grid Grid.Column="0"
                    ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                    Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}">
                <Border Grid.Column="0" Width="16">
                  <v:ChangeTreeNodeToggleButton Classes="tree_expander"
                                                Focusable="False"
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                IsVisible="{Binding IsFolder}"/>
                </Border>

                <ToggleButton Grid.Column="1"
                              Classes="folder"
                              Focusable="False"
                              Width="14" Height="14"
                              Margin="1,1,1,0"
                              Foreground="{DynamicResource Brush.Modified}"
                              IsChecked="{Binding IsExpanded}"
                              IsVisible="{Binding IsFolder}"/>

                <v:ChangeStatusIcon Grid.Column="2"
                                    Width="14" Height="14"
                                    Margin="1,0"
                                    IsUnstagedChange="{Binding #ThisControl.IsUnstagedChange}"
                                    Change="{Binding Change}"
                                    IsVisible="{Binding !IsFolder}"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding ConflictMarker, Mode=OneWay}"
                           Foreground="{DynamicResource Brush.Warning}"
                           FontWeight="Bold"
                           Margin="4,0,0,0"
                           IsVisible="{Binding ShowConflictMarker}"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding DisplayName, Mode=OneWay}"
                           Margin="5,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>

              <Panel Grid.Column="1">
                <Panel.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding ElementName="ThisControl" Path="HasRowAction"/>
                    <Binding Path="!IsFolder"/>
                  </MultiBinding>
                </Panel.IsVisible>
                <Button Classes="flat row_action"
                        Classes.stage="{Binding #ThisControl.IsUnstagedChange}"
                        Classes.unstage="{Binding #ThisControl.IsStagedChange}"
                        Click="OnRowActionClicked">
                  <Panel>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.StageFile}" IsVisible="{Binding #ThisControl.IsUnstagedChange}"/>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.UnstageFile}" IsVisible="{Binding #ThisControl.IsStagedChange}"/>
                  </Panel>
                </Button>
              </Panel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:ChangeCollectionContainer>
    </DataTemplate>

    <DataTemplate DataType="vm:ChangeCollectionAsGrid">
      <v:ChangeCollectionContainer Focusable="True"
                                   ItemsSource="{Binding Changes}"
                                   SelectedItems="{Binding SelectedChanges, Mode=TwoWay}"
                                   SelectionMode="Multiple"
                                   SelectionChanged="OnRowSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:Change">
            <Grid ColumnDefinitions="*,Auto"
                  Height="26"
                  Background="Transparent"
                  DoubleTapped="OnRowDoubleTapped"
                  DataContextChanged="OnRowDataContextChanged">
              <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,*" Margin="6,0,0,0">
                <v:ChangeStatusIcon Grid.Column="0"
                                    Width="14" Height="14"
                                    IsUnstagedChange="{Binding #ThisControl.IsUnstagedChange}"
                                    Change="{Binding}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ConflictMarker}"
                           Foreground="{DynamicResource Brush.Warning}"
                           FontWeight="Bold"
                           Margin="4,0,0,0"
                           IsVisible="{Binding IsConflicted}"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding Path, Converter={x:Static c:PathConverters.PureFileName}}"
                           Margin="6,0,0,0"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding Path, Converter={x:Static c:PathConverters.DirectoryPrefix}}"
                           Foreground="{DynamicResource Brush.FG2}"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>

              <Panel Grid.Column="1" IsVisible="{Binding #ThisControl.HasRowAction}">
                <Button Classes="flat row_action"
                        Classes.stage="{Binding #ThisControl.IsUnstagedChange}"
                        Classes.unstage="{Binding #ThisControl.IsStagedChange}"
                        Click="OnRowActionClicked">
                  <Panel>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.StageFile}" IsVisible="{Binding #ThisControl.IsUnstagedChange}"/>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.UnstageFile}" IsVisible="{Binding #ThisControl.IsStagedChange}"/>
                  </Panel>
                </Button>
              </Panel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:ChangeCollectionContainer>
    </DataTemplate>

    <DataTemplate DataType="vm:ChangeCollectionAsList">
      <v:ChangeCollectionContainer Focusable="True"
                                   ItemsSource="{Binding Changes}"
                                   SelectedItems="{Binding SelectedChanges, Mode=TwoWay}"
                                   SelectionMode="Multiple"
                                   SelectionChanged="OnRowSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="m:Change">
            <Grid ColumnDefinitions="*,Auto"
                  Height="26"
                  Background="Transparent"
                  DoubleTapped="OnRowDoubleTapped"
                  DataContextChanged="OnRowDataContextChanged">
              <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*" Margin="6,0,0,0">
                <v:ChangeStatusIcon Grid.Column="0"
                                    Width="14" Height="14"
                                    IsUnstagedChange="{Binding #ThisControl.IsUnstagedChange}"
                                    Change="{Binding}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ConflictMarker}"
                           Foreground="{DynamicResource Brush.Warning}"
                           FontWeight="Bold"
                           Margin="4,0,0,0"
                           IsVisible="{Binding IsConflicted}"/>

                <!-- The folder part is dimmed and trimmed from the front, so the file name always stays visible. -->
                <v:ChangePathPresenter Grid.Column="2"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Path="{Binding Path}"
                                       FontFamily="{DynamicResource Fonts.Default}"
                                       FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize}"
                                       Foreground="{DynamicResource Brush.FG1}"
                                       DirectoryForeground="{DynamicResource Brush.FG2}"/>
              </Grid>

              <Panel Grid.Column="1" IsVisible="{Binding #ThisControl.HasRowAction}">
                <Button Classes="flat row_action"
                        Classes.stage="{Binding #ThisControl.IsUnstagedChange}"
                        Classes.unstage="{Binding #ThisControl.IsStagedChange}"
                        Click="OnRowActionClicked">
                  <Panel>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Unstaged.StageFile}" IsVisible="{Binding #ThisControl.IsUnstagedChange}"/>
                    <TextBlock Text="{DynamicResource Text.WorkingCopy.Staged.UnstageFile}" IsVisible="{Binding #ThisControl.IsStagedChange}"/>
                  </Panel>
                </Button>
              </Panel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:ChangeCollectionContainer>
    </DataTemplate>
  </UserControl.DataTemplates>
</UserControl>
